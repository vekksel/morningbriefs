# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_BOT_USERNAME=mymorningbriefsbot

# JWT secret (any random string, used to sign login tokens)
JWT_SECRET=change_me_to_something_random

# Server
PORT=3000

# n8n integration (shared secret so n8n can call our API)
N8N_API_KEY=change_me_to_a_random_string

# Google OAuth2 (for Calendar, Stage 5)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
